{
  "kind": "collectionType",
  "collectionName": "webinars",
  "info": {
    "singularName": "webinar",
    "pluralName": "webinars",
    "displayName": "webinar",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "organizer": {
      "type": "string"
    },
    "speaker": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "signup_url": {
      "type": "string"
    },
    "event_date": {
      "type": "date"
    },
    "event_start_time": {
      "type": "time"
    },
    "event_end_time": {
      "type": "time"
    },
    "description": {
      "type": "blocks"
    },
    "content": {
      "type": "blocks"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "docs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::doc.doc",
      "inversedBy": "webinars"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "webinars"
    },
    "commissions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::commission.commission",
      "inversedBy": "webinars"
    },
    "sectors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::sector.sector",
      "inversedBy": "webinars"
    },
    "subcommittees": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::subcommittee.subcommittee",
      "inversedBy": "webinars"
    },
    "codes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::code.code",
      "inversedBy": "webinars"
    },
    "countries": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::country.country",
      "inversedBy": "webinars"
    },
    "notify": {
      "type": "component",
      "component": "notifications.notification-selector",
      "repeatable": false
    },
    "notificationMode": {
      "type": "enumeration",
      "enum": [
        "none",
        "test",
        "normal",
        "both"
      ]
    },
    "notificationTestEmail": {
      "type": "email"
    },
    "statistics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::statistic.statistic",
      "mappedBy": "webinars"
    },
    "provider": {
      "type": "enumeration",
      "default": "external",
      "enum": [
        "external",
        "zoom"
      ]
    },
    "modality": {
      "type": "enumeration",
      "default": "virtual",
      "enum": [
        "virtual",
        "presencial",
        "hibrido"
      ]
    },
    "access_type": {
      "type": "enumeration",
      "default": "free",
      "enum": [
        "free",
        "paid"
      ]
    },
    "event_status": {
      "type": "enumeration",
      "default": "scheduled",
      "enum": [
        "scheduled",
        "cancelled",
        "finished"
      ]
    },
    "zoom_sync_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "synced",
        "error"
      ]
    },
    "recording_status": {
      "type": "enumeration",
      "default": "none",
      "enum": [
        "none",
        "processing",
        "available"
      ]
    },
    "price": {
      "type": "decimal"
    },
    "duration_minutes": {
      "type": "integer"
    },
    "capacity": {
      "type": "integer",
      "default": 300
    },
    "start_datetime": {
      "type": "datetime"
    },
    "registration_enabled": {
      "type": "boolean",
      "default": true
    },
    "zoom_webinar_id": {
      "type": "string",
      "private": true
    },
    "zoom_passcode": {
      "type": "string",
      "private": true
    },
    "zoom_sync_error": {
      "type": "text",
      "private": true
    },
    "recording_path": {
      "type": "string",
      "private": true
    },
    "webinar_registrations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::webinar-registration.webinar-registration",
      "mappedBy": "webinar"
    },
    "webinar_attendances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::webinar-attendance.webinar-attendance",
      "mappedBy": "webinar"
    }
  }
}
