{
  "kind": "collectionType",
  "collectionName": "webinar_registrations",
  "info": {
    "singularName": "webinar-registration",
    "pluralName": "webinar-registrations",
    "displayName": "Webinar Registration"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "webinar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::webinar.webinar",
      "inversedBy": "webinar_registrations"
    },
    "brain_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brain-user.brain-user",
      "inversedBy": "webinar_registrations"
    },
    "registration_status": {
      "type": "enumeration",
      "default": "registered",
      "enum": [
        "registered",
        "cancelled",
        "attended",
        "no_show"
      ]
    },
    "source": {
      "type": "enumeration",
      "default": "web",
      "enum": [
        "web",
        "on_join"
      ]
    },
    "registered_at": {
      "type": "datetime"
    },
    "cancelled_at": {
      "type": "datetime"
    },
    "confirmation_sent_at": {
      "type": "datetime"
    },
    "reminder_3d_sent_at": {
      "type": "datetime"
    },
    "reminder_1d_sent_at": {
      "type": "datetime"
    },
    "reminder_1h_sent_at": {
      "type": "datetime"
    },
    "post_event_sent_at": {
      "type": "datetime"
    },
    "zoom_registrant_id": {
      "type": "string",
      "private": true
    },
    "zoom_join_token": {
      "type": "string",
      "private": true
    },
    "attended_minutes": {
      "type": "integer"
    },
    "webinar_attendances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::webinar-attendance.webinar-attendance",
      "mappedBy": "webinar_registration"
    },
    "zoom_join_url": {
      "type": "text"
    }
  }
}
